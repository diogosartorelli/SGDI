        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * sum(rate(http_requests_total{app_name=\"flask-demandas\", status=~\"[45]..\"}[$__rate_interval])) / sum(rate(http_requests_total{app_name=\"flask-demandas\"}[$__rate_interval]))",
          "legendFormat": "% erros",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
